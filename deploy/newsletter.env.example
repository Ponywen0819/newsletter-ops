# 複製到 ~/.config/newsletter-ops/env，chmod 600。不要放進 repo。
# 這個檔由 run_daily.sh 用 shell 語法載入：值含空格一定要加引號。
# web.py 不讀這個檔（systemd 的 web service 沒有載入），所以網頁程序拿不到這些機密。

GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
# NEWSLETTER_MAIL_TO="a@example.com,b@example.com"   # 沒設就寄給 GMAIL_USER

# agent_run.py 用訂閱額度呼叫 Claude（刻意不支援 ANTHROPIC_API_KEY）。在自己的電腦執行 `claude setup-token` 取得，效期一年。
# 也可以不放在這裡，改開 web 的 /auth 貼上（只能從本機開，見 README「認證」）；兩邊都有時以 /auth 存的為準。
CLAUDE_CODE_OAUTH_TOKEN=""
