# 白名單模式：先忽略全部，再逐一放行。
# 新檔案預設不進版控；要追蹤就在下面加一行 !/路徑，並用 git status 確認。

*
# 讓 git 走得進子目錄（只放行目錄，裡面的檔案仍需下面的規則放行）
!*/

# 專案文件與入口
!/.gitignore
!/README.md
!/ISSUES.md
!/run_daily.sh
!/pyproject.toml
!/uv.lock
!/.python-version

# Docker 部署（真正的機密放 .env，已被上面的 * 擋掉，只放行範本）
!/Dockerfile
!/.dockerignore
!/docker-compose.yml
!/.env.example
!/docker/*.sh

# 部署範本（systemd 單元、cloudflared 設定、env 範本；真正的機密不放這裡）
!/deploy/*.service
!/deploy/*.timer
!/deploy/*.example
!/deploy/*.py

# Python 成員（uv workspace）：只放行 pyproject.toml 與 src/<套件>/ 底下的 .py
!/shared/pyproject.toml
!/shared/src/**/*.py
!/agent/pyproject.toml
!/agent/src/**/*.py
!/notify/pyproject.toml
!/notify/src/**/*.py
!/web/server/pyproject.toml
!/web/server/src/**/*.py

# Web 前端（Vite + React）：只放行原始碼、設定與鎖檔
!/web/ui/index.html
!/web/ui/package.json
!/web/ui/package-lock.json
!/web/ui/tsconfig.json
!/web/ui/vite.config.ts
!/web/ui/src/**
!/web/ui/public/**

# 設定：主設定、興趣檔、來源清單
!/config/*.json
!/config/*.md
!/config/sources.d/*.json

# 報告撰寫的 skill
!/.claude/skills/**

# GitHub Actions（push 時跑自我檢查）
!/.github/**

# 刻意不放行（每日生成物與本機狀態；本 repo 是 public，也不留備份，見 README「資料保存」）：
#   web/ui/dist/             前端建置產物，`cd web/ui && npm run build` 重建
#   web/ui/node_modules/     套件，`npm install` 重建
#   data/raw、data/curated   每日抓取結果，可重跑
#   reports/                 每日報告
#   state/feedback.jsonl     人工標記，只是更新 config/interests.md 時參考的中間產物
#   state/seen.json          去重記憶，本機狀態
#   logs/                    執行紀錄與 metrics
#   .venv/                   uv 建的環境
#   __pycache__/、.DS_Store  由 * 自動忽略

# 讓 git 不必走進這兩個目錄（上面的 !*/ 會讓它逐檔檢查 node_modules）
/web/ui/node_modules/
/web/ui/dist/

# 放行規則之後再擋一次系統雜物（例如 .claude/skills/** 會連 .DS_Store 一起放行）
.DS_Store
