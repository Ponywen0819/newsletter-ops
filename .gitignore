# 白名單模式：先忽略全部，再逐一放行。
# 新檔案預設不進版控；要追蹤就在下面加一行 !/路徑，並用 git status 確認。

*
# 讓 git 走得進子目錄（只放行目錄，裡面的檔案仍需下面的規則放行）
!*/

# 專案文件與入口
!/.gitignore
!/.gitattributes
!/README.md
!/CLAUDE.md
!/ISSUES.md
!/*/README.md
!/*/*/README.md
!/*/*/ISSUES.md
!/.githooks/*
!/ruff.toml
!/.python-version
!/package.json
!/package-lock.json
!/nx.json

# Docker 部署（真正的機密放 .env，已被上面的 * 擋掉，只放行範本）
!/Dockerfile
!/.dockerignore
!/docker-compose.yml
!/docker-compose.test.yml
!/.env.example
!/docker/*.sh
!/docker/*.conf

# 部署範本（systemd 單元、cloudflared 設定、env 範本；真正的機密不放這裡）
!/deploy/*.service
!/deploy/*.timer
!/deploy/*.example
!/deploy/*.py
!/deploy/*.sh
!/deploy/cloudflare-tunnel.json

# 模組（apps/、packages/、web/ 底下一個目錄一個）：Nx 專案檔
!/*/*/project.json

# Python 模組（各自一個 uv 專案）：只放行 pyproject.toml、uv.lock、src/<套件>/ 與 tests/ 底下的 .py
!/*/*/pyproject.toml
!/*/*/uv.lock
!/*/*/src/**/*.py
!/*/*/tests/*.py

# Node 模組（Vite + React）：只放行原始碼、設定與鎖檔
!/*/*/index.html
!/*/*/package.json
!/*/*/package-lock.json
!/*/*/tsconfig.json
!/*/*/vite.config.ts
!/*/*/.oxlintrc.json
!/*/*/src/**
!/*/*/public/**

# 設定：主設定、興趣檔、來源清單
!/config/*.json
!/config/*.md
!/config/sources.d/*.json

# 報告撰寫的 skill
!/.claude/skills/**

# GitHub Actions（push 時跑 lint 與測試）
!/.github/**

# 刻意不放行（每日生成物與本機狀態；本 repo 是 public，也不留備份，見 README「資料保存」）：
#   apps/web-ui/dist/             前端建置產物，`cd apps/web-ui && npm run build` 重建
#   apps/web-ui/node_modules/     套件，`npm install` 重建
#   data/raw、data/curated   每日抓取結果，可重跑
#   reports/                 每日報告
#   state/feedback.jsonl     人工標記，只是更新 config/interests.md 時參考的中間產物
#   state/seen.json          去重記憶，本機狀態
#   logs/                    執行紀錄與 metrics
#   .venv/                   uv 建的環境（每個 Python 模組一個）
#   node_modules/、.nx/      根目錄的 Nx 與快取，`npm install` 重建
#   __pycache__/、.DS_Store  放行規則之後再擋（見檔尾）

# 讓 git 不必走進這些目錄（上面的 !*/ 會讓它逐檔檢查 node_modules）
node_modules/
/*/*/dist/
/.nx/

# 放行規則之後再擋一次系統雜物（例如 .claude/skills/** 會連 .DS_Store 一起放行）
.DS_Store
__pycache__/
