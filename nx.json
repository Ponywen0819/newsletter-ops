{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    {
      "plugin": "@nxlv/python",
      "options": {
        "packageManager": "uv"
      }
    }
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ]
  },
  "targetDefaults": {
    "selftest": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/config/**/*"
      ],
      "options": {
        "env": {
          "NEWSLETTER_DEBUG": "0"
        }
      }
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/ruff.toml"
      ]
    },
    "typecheck": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "build": {
      "cache": true,
      "outputs": [
        "{projectRoot}/dist"
      ]
    }
  }
}
