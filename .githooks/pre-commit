#!/usr/bin/env bash
# 啟用：git config core.hooksPath .githooks（每個 clone 做一次）。略過：git commit --no-verify
set -euo pipefail

files=()
while IFS= read -r -d '' f; do files+=("$f"); done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.py')
[ ${#files[@]} -eq 0 ] && exit 0

# ponytail: 檢查的是工作目錄的檔案，不是暫存區的版本；部分暫存時可能不準
uvx ruff@0.17.3 check -- "${files[@]}"
