{
  "name": "worker",
  "projectType": "application",
  "tags": [
    "type:app",
    "lang:py"
  ],
  "targets": {
    "install": {
      "command": "uv sync --locked --project {projectRoot}"
    },
    "test": {
      "command": "uv run --locked --project {projectRoot} pytest -q {projectRoot}"
    },
    "start": {
      "command": "uv run --locked --project {projectRoot} worker"
    },
    "once": {
      "command": "uv run --locked --project {projectRoot} worker --once"
    },
    "lint": {
      "command": "uvx ruff@0.17.3 check {projectRoot}"
    },
    "dev": {
      "command": "uv run --locked --project {projectRoot} worker --host 127.0.0.1",
      "options": {
        "env": {
          "NEWSLETTER_SCHEDULE": "off"
        }
      }
    }
  }
}
