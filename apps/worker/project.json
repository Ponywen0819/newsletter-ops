{
  "name": "worker",
  "projectType": "application",
  "tags": [
    "type:app",
    "lang:py"
  ],
  "targets": {
    "test": {
      "command": "uv run --locked --project {projectRoot} pytest -q {projectRoot}"
    },
    "start": {
      "command": "uv run --locked --project {projectRoot} worker"
    },
    "once": {
      "command": "uv run --locked --project {projectRoot} worker --once"
    },
    "lint": {
      "command": "uvx ruff@0.17.3 check {projectRoot}"
    }
  }
}
