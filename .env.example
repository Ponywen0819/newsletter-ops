# 複製成 .env，chmod 600。不要放進 repo（.gitignore 與 .dockerignore 都已排除）。
# docker compose 會自動讀這個檔；值含空格可以加引號。

# Cloudflare Zero Trust → Networks → Tunnels → 建立 Tunnel 後顯示的 token
TUNNEL_TOKEN=

GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
# NEWSLETTER_MAIL_TO=a@example.com,b@example.com   # 沒設就寄給 GMAIL_USER

# agent_run.py 呼叫 Claude Agent SDK 用，按 token 計費
ANTHROPIC_API_KEY=sk-ant-...

# NEWSLETTER_RUN_AT=08:00   # 每日執行時間（容器的時區是 Asia/Taipei）
